    "coverage": "50 U.S. states plus Washington, D.C.",
    "intended_use": "Use cost_multiplier to localize a breed base premium by state before rendering quote widgets or insurance comparison modules.",
    "national_benchmark_dog_premium_usd": 43.0,
    "national_benchmark_dog_vet_visit_usd": 88.88,
    "cost_multiplier_formula": "cost_multiplier = (insurance_rate_factor * 0.75) + (vet_visit_factor * 0.25)",
