    "vet_visit_factor_formula": "dog_avg_vet_visit_usd / 88.88",
    "why_hybrid_formula": "State insurance pricing already captures geography, but adding routine vet visit cost makes the index more stable for localized content and calculators.",
    "source_basis": [
      "Insurify 2026 state dog premium averages for accident-and-illness coverage",
      "CareCredit average dog vet visit cost by state/district"
